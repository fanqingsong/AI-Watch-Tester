# AI-Watch-Tester Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# AI Provider Configuration (Choose One)
# ============================================================================

# ZhipuAI (智谱AI) - Recommended for Chinese users
ZHIPUAI_API_KEY=your_zhipu_api_key_here
ZHIPUAI_MODEL=glm-4-flash

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (Local)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ============================================================================
# Cloud SaaS Configuration
# ============================================================================

# Encryption Key (REQUIRED for Cloud SaaS)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AWT_ENCRYPTION_KEY=your_generated_encryption_key_here

# Default AI Provider for Cloud (fallback when user has no personal config)
AWT_AI_PROVIDER=zhipuai
AWT_AI_API_KEY=your_zhipu_api_key_here
AWT_AI_MODEL=glm-4-flash

# Database (Optional, defaults to SQLite)
# AWT_DATABASE_URL=sqlite+aiosqlite:///./cloud_data/awt_cloud.db
# AWT_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Rate Limiting (Monthly tests per tier)
AWT_RATE_LIMIT_FREE=5
AWT_RATE_LIMIT_PRO=100
AWT_RATE_LIMIT_TEAM=500

# Debug Mode
AWT_DEBUG=false

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
