# 智谱AI配置示例文件
# 复制此文件为 .env 并填入你的API密钥

# 智谱AI API密钥（必需）
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# 智谱AI模型（可选，默认：glm-4.7）
# 可选模型：glm-4.7, glm-4, glm-4-plus, glm-4-0520
ZHIPUAI_MODEL=glm-4.7

# 其他AI提供商（可选）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434


AWT_AI_PROVIDER=zhipuai
AWT_AI_API_KEY=您的智谱API密钥
AWT_AI_MODEL=glm-4.7


